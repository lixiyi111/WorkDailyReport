# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，严禁提交。
APP_ENV=development

# GitHub 只读个人访问令牌（仅用于采集提交记录）
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
# 逗号分隔：owner/repo
GITHUB_REPOS=

# 飞书开放平台自建应用
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=https://open.feishu.cn
# 飞书未就绪时用 Mock 数据源（GitHub 仍走真实采集）
FEISHU_USE_MOCK=false
# Mock 飞书数据使用的成员邮箱（逗号分隔）
MOCK_MEMBER_EMAILS=
# 逗号分隔的群 chat_id
FEISHU_CHAT_IDS=
# 日报推送目标群 chat_id
FEISHU_REPORT_CHAT_ID=

# SMTP 邮件推送（QQ 邮箱使用 SMTP 授权码，不是登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_AUTH_CODE=
SMTP_FROM_NAME=智能日报
# 逗号分隔的收件邮箱
REPORT_RECIPIENTS=

# MySQL（本项目端口 3305；建表见 sql/schema.sql）
DB_HOST=127.0.0.1
DB_PORT=3305
DB_USER=root
DB_PASSWORD=
DB_NAME=daily_report
DB_CHARSET=utf8mb4

# 暂不自动建表，使用 sql/schema.sql
AUTO_CREATE_TABLES=false
