# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，严禁提交。
APP_ENV=development

# GitHub 只读个人访问令牌（仅用于采集提交记录）
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# 飞书开放平台自建应用
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# SMTP 邮件推送（QQ 邮箱使用 SMTP 授权码，不是登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_AUTH_CODE=
SMTP_FROM_NAME=智能日报

# MySQL（数据库初始化在功能阶段实现）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=daily_report
DB_CHARSET=utf8mb4
